{
  "version": 1,
  "services": [
    {
      "name": "web",
      "dockerfile": "Dockerfile.freecad-gui",
      "context": ".",
      "route": "public",
      "port": 8080,
      "healthPath": "/healthz",
      "storage": {
        "sizeGb": 10,
        "mountPath": "/data",
        "fsGroup": 10001
      },
      "resources": {
        "cpu": 1.5,
        "memoryMb": 4096
      }
    }
  ],
  "models": [
    {
      "env": "TEXT_MODEL",
      "type": "chat",
      "default": "anthropic.claude-sonnet-4-6",
      "allowed": [
        "anthropic.claude-sonnet-4-6"
      ]
    }
  ],
  "auth": {
    "bearerPassthroughPrefixes": [
      "/api/freecad/sessions",
      "/api/generate"
    ]
  }
}
