{
  "version": 1,
  "services": [
    {
      "name": "web",
      "dockerfile": "Dockerfile.freecad-gui",
      "context": ".",
      "route": "public",
      "port": 8080,
      "healthPath": "/healthz",
      "storage": {
        "sizeGb": 10,
        "mountPath": "/data"
      },
      "resources": {
        "cpu": 2,
        "memoryMb": 4096
      }
    }
  ],
  "models": [
    {
      "env": "TEXT_MODEL",
      "type": "chat",
      "default": "anthropic.claude-sonnet-4-6",
      "allowed": [
        "anthropic.claude-sonnet-4-6"
      ]
    }
  ]
}
